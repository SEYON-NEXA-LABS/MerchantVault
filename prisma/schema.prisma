datasource db {
  provider  = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id                   String            @id @default(uuid())
  name                 String
  code                 String            @unique // e.g., "vtex", "othercompany"
  shopifyStoreUrl      String?
  shopifyAccessToken   String?
  whatsappNumber       String?
  whatsappApiKey       String?
  onboardingStep       Int               @default(1)
  onboardingCompleted  Boolean           @default(false)
  timezone             String            @default("UTC")
  currency             String            @default("USD")
  contactEmail         String?
  logoUrl              String?
  isActive             Boolean           @default(true)
  users                User[]
  variants             ProductVariant[]
  movements            StockMovement[]
  fulfillments         OrderFulfillment[]
  abandonedCarts       AbandonedCheckout[]
  warehouses           Warehouse[]
  transfers            StockTransfer[]
  purchaseOrders       PurchaseOrder[]
  createdAt            DateTime          @default(now())
}

model Warehouse {
  id                 String           @id @default(uuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String           
  code               String           
  addressLine1       String
  addressLine2       String?
  city               String
  state              String
  zip                String
  country            String
  isDefaultPickup    Boolean          @default(false)
  fulfillments       OrderFulfillment[]
  stocks             WarehouseStock[]
  movements          StockMovement[]
  transfersFrom      StockTransfer[]  @relation("FromWarehouse")
  transfersTo        StockTransfer[]  @relation("ToWarehouse")
  purchaseOrders     PurchaseOrder[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([companyId, code])
}

model WarehouseStock {
  id                String          @id @default(uuid())
  warehouseId       String
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variantId         String
  variant           ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  currentStockLevel Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([warehouseId, variantId])
}

model User {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  email     String   @unique // Dummy email generated behind the scenes e.g. username@companycode.local
  username  String
  password  String   @default("password123")
  isActive  Boolean  @default(true)
  role      UserRole @default(STAFF)
  createdAt DateTime @default(now())

  @@unique([companyId, username])
}

model ProductVariant {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  shopifyVariantId  String          
  sku               String          
  title             String          
  size              String          
  color             String          
  barcodeString     String          
  safetyStockLimit  Int             @default(5) 
  currentStockLevel Int             @default(0) 
  velocity          ProductVelocity @default(MEDIUM)
  leadTimeDays      Int             @default(7)
  averageDailySales Float           @default(0.0)
  movements         StockMovement[]
  stocks            WarehouseStock[]
  transfers         StockTransfer[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([companyId, shopifyVariantId])
  @@unique([companyId, sku])
  @@unique([companyId, barcodeString])
}

model StockMovement {
  id               String         @id @default(uuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id])
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId      String?
  warehouse        Warehouse?     @relation(fields: [warehouseId], references: [id])
  type             MovementType   
  quantity         Int            
  operatorEmail    String         
  syncStatus       SyncState      @default(PENDING) 
  errorMessage     String?        
  createdAt        DateTime       @default(now())
}

model OrderFulfillment {
  id                    String         @id @default(uuid())
  companyId             String
  company               Company        @relation(fields: [companyId], references: [id])
  shopifyOrderId        String         
  orderNumber           String         
  customerName          String
  customerPhone         String
  shippingAddressLine1  String?
  shippingAddressLine2  String?
  shippingCity          String?
  shippingState         String?
  shippingZip           String?
  shippingCountry       String?
  totalWeightKg         Float          @default(0.35)
  awbNumber             String?        
  courierPartner        String?        
  deliveryStatus        ShippingStatus @default(PROCESSING) 
  warehouseId           String?
  warehouse             Warehouse?     @relation(fields: [warehouseId], references: [id])
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([companyId, shopifyOrderId])
}

model AbandonedCheckout {
  id               String         @id @default(uuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id])
  shopifyCartId    String         
  customerPhone    String
  customerName     String
  cartValue        Float
  recoveryStatus   RecoveryState  @default(PENDING) 
  whatsappSentAt   DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([companyId, shopifyCartId])
}

enum MovementType {
  INWARD
  OUTWARD
}

enum SyncState {
  PENDING
  SUCCESS
  FAILED
}

enum RecoveryState {
  PENDING
  WHATSAPP_SENT
  RECOVERED
}

enum ShippingStatus {
  PROCESSING
  SHIPPED
  DELIVERED
  RTO_INITIATED
  RTO_RECEIVED
}

enum ProductVelocity {
  FAST
  MEDIUM
  SLOW
}

enum UserRole {
  SUPERADMIN
  TENANTADMIN
  STAFF
}

model StockTransfer {
  id               String          @id @default(uuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id])
  variantId        String
  variant          ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  fromWarehouseId  String
  fromWarehouse    Warehouse       @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId    String
  toWarehouse      Warehouse       @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  quantity         Int
  status           TransferStatus  @default(PENDING)
  operatorEmail    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

enum TransferStatus {
  PENDING
  SENT
  COMPLETED
  CANCELLED
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  companyId        String
  company          Company             @relation(fields: [companyId], references: [id])
  poNumber         String              
  vendorName       String
  vendorEmail      String?
  status           PurchaseOrderStatus @default(DRAFT)
  warehouseId      String
  warehouse        Warehouse           @relation(fields: [warehouseId], references: [id])
  items            PurchaseOrderItem[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([companyId, poNumber])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

model PurchaseOrderItem {
  id              String         @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  quantityOrdered Int
  quantityReceived Int            @default(0)
  costPrice       Float          @default(0.0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}
